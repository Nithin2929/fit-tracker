# ============================================================================
# Copy this file to .env, then replace every placeholder with your real value.
#
#   Copy-Item .env.example .env
#
# .env is listed in .gitignore, so your real password will not be committed.
# Never put real passwords in .env.example or in Python source code.
# ============================================================================

# Flask signs session cookies with this value.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# MySQL connection details
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fitness_wellness_db

# Dedicated application account created by database/app_user.sql
# (Use root only for local experiments; a dedicated user is safer.)
DB_USER=fitness_app
DB_PASSWORD=replace-with-the-password-from-database-app_user.sql
