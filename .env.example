# ============================================================================
# Copy this file to .env, then replace every placeholder with your real value.
#
#   Copy-Item .env.example .env
#
# .env is listed in .gitignore, so your real password will not be committed.
# Never put real passwords in .env.example or in Python source code.
# ============================================================================

# Flask signs session cookies with this value.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Aiven Cloud MySQL connection details (https://console.aiven.io/)
DB_HOST=your-aiven-host
DB_PORT=your-aiven-port
DB_USER=your-aiven-username
DB_PASSWORD=your-aiven-password
DB_NAME=fitness_wellness_db

# Aiven provides a CA certificate (ca.pem). Download it from the Aiven console,
# put it in a folder like certs/ at the project root (do not commit it), and
# point to it here. The app requires TLS certificate verification.
DB_SSL_CA=certs/ca.pem

# Optional: only enable debug in local development when you know what you are doing.
# FLASK_DEBUG=false
# SESSION_COOKIE_SECURE=false
# DB_CONNECT_TIMEOUT=10

# Optional: development web server address/port (the database is not local).
# APP_HOST=127.0.0.1
# APP_PORT=5000
